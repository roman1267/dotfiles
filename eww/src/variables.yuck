;; movie_mode var
(defpoll is_movie_mode
  :interval "60m"
  :initial "false"
  "./scripts/movie_mode.sh is_movie_mode"
)

;; Sys info vars
(defvar time_date_shown 0)
;; utils vars
(defvar utils_stack 0)
(defpoll whoami
  :interval "15m"
  "whoami"
)

;; brightness vars
(defpoll current_brightness
  :interval "60m"
  "echo \"$(tail -n 1 /sys/class/backlight/intel_backlight/brightness)/$(tail -n 1 /sys/class/backlight/intel_backlight/max_brightness)*100\" | bc -l")
(defvar current_warmth 10)
(defvar bright-slidedir "slideup")

;; volume vars
(defpoll current_volume
  :interval "60m"
  :initial "0"
  "pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | tr -dc [:digit:]"
)
(defpoll is_muted
  :interval "60m"
  "pactl get-sink-mute @DEFAULT_SINK@"
)
(defvar vol 0)
(defvar vol-slidedir "slideup")

(defvar night_shift false)
