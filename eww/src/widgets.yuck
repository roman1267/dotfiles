;;
;; Toplevel widgets declaration
;;

;; bar dependencies
(include "./src/widgets/bar.yuck")

(defwidget bar[]
  (centerbox
    :spacing 80
    :hexpand true
    (box
      :halign "start"
      (sys_info)
    )
    (box
      :halign "center"
      (workspaces)
    )
    (box
      :halign "end"
      (utils)
      (systray)
    )
  )
)

;; Options Menu dependencies
(include "./src/widgets/options_menu.yuck")

(defwidget options_menu []
  (scroll
    :vscroll true
    :hscroll false
    (box
      :orientation "v"
      (brightness)
      (screen_temperature)
    )
  )
)

