(defwindow bar
  :monitor 0
  :geometry (geometry
    ;; NOTE: Useless for i3
    ;; :x "0%"
    ;; :y "8px"
    ;; :width "60%"
    :height "30px"
    :anchor "top center"
  )
  :stacking "bg"
  :windowtype "dock"
  :reserve (struts :distance "60px" :side "top")
  :wm-ignore false
  (bar)
)

(defwindow options_menu
  :monitor 0
  :geometry (geometry
    :x "80%"
    :y "45px"
    :width "15%"
    :height "300px"
  )
  :stacking "bg"
  :windowtype "dialog"
  :wm-ignore true
  (options_menu)
)
